# รหัสผ่านสำหรับล็อกอินหน้าแอดมิน
ADMIN_PASSWORD=change-me
# คีย์ลับสำหรับเซ็น token แอดมิน (สุ่มยาว ๆ เช่น `openssl rand -hex 32`)
JWT_SECRET=change-me-to-a-long-random-string
# จำนวนบัตรทั้งหมด
TOTAL_TICKETS=600
# URL ของหน้าเว็บ frontend (สำหรับ CORS)
CORS_ORIGIN=http://localhost:3000
# ช่องทางติดต่อทีมงาน แสดงเมื่อสลิปไม่ผ่าน
CONTACT_INFO=LINE: @hticket
# พอร์ตของ backend
PORT=8080
# ใช้ตอนรันนอก Docker (cargo run / cargo test)
DATABASE_URL=postgres://hticket:hticket@localhost:5432/hticket
SLIP_DIR=./data/slips
