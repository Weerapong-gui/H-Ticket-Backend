# รหัสผ่านสำหรับล็อกอินหน้าแอดมิน (อย่างน้อย 12 ตัวอักษร ไม่งั้นระบบไม่ยอมเริ่ม)
ADMIN_PASSWORD=change-me-please
# คีย์ลับสำหรับเซ็น token แอดมิน (อย่างน้อย 32 ตัวอักษร สร้างด้วย `openssl rand -hex 32`)
JWT_SECRET=change-me-to-a-long-random-string-0123456789
# จำนวนบัตรทั้งหมด
TOTAL_TICKETS=600
# URL ของหน้าเว็บ frontend (สำหรับ CORS)
CORS_ORIGIN=http://localhost:3000
# ช่องทางติดต่อทีมงาน แสดงเมื่อสลิปไม่ผ่าน
CONTACT_INFO="LINE: @hticket"
# รหัสผ่าน Postgres (บนเซิร์ฟเวอร์ควรเปลี่ยน; ต้องตั้งก่อนรัน compose ครั้งแรก)
POSTGRES_PASSWORD=hticket
# พอร์ตของ backend ตอนรันนอก Docker (ใน compose ใช้ 8080 เสมอ)
PORT=8080
# ใช้ตอนรันนอก Docker (cargo run / cargo test)
DATABASE_URL=postgres://hticket:hticket@localhost:5432/hticket
SLIP_DIR=./data/slips

# ---- เฉพาะบนเซิร์ฟเวอร์ ----
# พอร์ตบนเครื่องที่ใช้เปิด backend / Postgres (เซิร์ฟเวอร์มี 8080 และ 5432 ถูกใช้แล้ว)
# BACKEND_BIND=127.0.0.1:18080
# DB_BIND=127.0.0.1:15432
# token ของ Cloudflare Tunnel (Zero Trust → Networks → Tunnels)
# TUNNEL_TOKEN=
